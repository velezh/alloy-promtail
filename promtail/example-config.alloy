// Tails /var/log/*.log and sends the lines to Loki at $LOKI_URL.

loki.source.file "varlog" {
	targets = [{
		"__path__" = "/var/log/*.log",
		"job"      = "varlog",
	}]
	forward_to = [loki.write.default.receiver]

	file_match {
		enabled = true
	}
}

// Reading the systemd journal requires the host journal and machine ID, for example:
// docker run -v /var/log/journal:/var/log/journal:ro -v /etc/machine-id:/etc/machine-id:ro ...
//
// loki.relabel "journal" {
// 	forward_to = []
//
// 	rule {
// 		source_labels = ["__journal__systemd_unit"]
// 		target_label  = "unit"
// 	}
// }
//
// loki.source.journal "default" {
// 	relabel_rules = loki.relabel.journal.rules
// 	labels        = {"job" = "systemd-journal"}
// 	forward_to    = [loki.write.default.receiver]
// }

loki.write "default" {
	endpoint {
		url = coalesce(sys.env("LOKI_URL"), "http://localhost:3100/loki/api/v1/push")
	}
}
